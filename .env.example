# HANSBAU - Environment Variables (Coolify / Self-Hosted VPS)

# -------------------------------------------------------------
# SMTP Konfigurace pro odesílání poptávek z formulářů
# -------------------------------------------------------------
# Níže uvedené výchozí hodnoty jsou již přednastavené v kódu.
# V Coolify v záložce Environment Variables stačí nastavit SMTP_PASS (heslo).

SMTP_HOST=mail.mescon.eu
SMTP_PORT=465
SMTP_USER=hansbau@mescon.cz
SMTP_PASS=zde_vyplnte_heslo_schranky

# Příjemce poptávek (kam má e-mail dorazit):
CONTACT_EMAIL_TO=team@hansbau.com

# Odesílatel v hlavičce e-mailu (volitelné):
SMTP_FROM="HANSBAU Web" <hansbau@mescon.cz>
