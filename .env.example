# ==============================================================================
# HANSBAU - Konfigurace prostředí (Environment Variables / Secrets)
# Tyto proměnné nastavte v Coolify / VPS v sekci Environment Variables aplikace
# ==============================================================================

# 1. SMTP Konfigurace pro odesílání poptávek z formuláře i kalkulačky
# Server: mail.mescon.eu
# POZNÁMKA K PORTŮM V DOCKERU / COOLIFY:
# Doporučujeme port 587 (STARTTLS, SMTP_SECURE=false).
# Pokud Docker kontejner na stejném VPS nemůže dosáhnout veřejné IP (hairpin NAT),
# náš systém automaticky vyzkouší alternativní port (587 <-> 465).
SMTP_HOST=mail.mescon.eu
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=hansbau@mescon.cz
SMTP_PASS=vase_tajne_smtp_heslo
SMTP_FROM="HANSBAU Poptávky" <hansbau@mescon.cz>
# Volitelné: ignorovat případné neplatné SSL certifikáty (default: true)
# SMTP_REJECT_UNAUTHORIZED=false

# 2. Cílový e-mail (kam se mají poptávky doručovat)
# Lze zadat i více adres oddělených čárkou (např. team@hansbau.com, ludvik@mescon.cz)
CONTACT_EMAIL_TO=team@hansbau.com

# 3. Zabezpečení administrace (/admin)
# Heslo pro přihlášení do administrace a správy leadů (default: hansbau2026)
ADMIN_PASSWORD=hansbau2026
# Tajný klíč pro HMAC podpis cookie relace (libovolný dlouhý náhodný řetězec)
ADMIN_SESSION_SECRET=hansbau_secure_admin_salt_2026_change_in_production

# 4. Produkční prostředí
NODE_ENV=production
